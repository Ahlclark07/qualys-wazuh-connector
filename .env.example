QUALYS_BASE_URL=https://qualysapi.qualys.eu
QUALYS_USERNAME=your-api-user
QUALYS_PASSWORD=your-api-password

QUALYS_DETECTIONS_PATH=/api/2.0/fo/asset/host/vm/detection/
QUALYS_KB_PATH=/api/2.0/fo/knowledge_base/vuln/
QUALYS_TRUNCATION_LIMIT=1000
QUALYS_STATUSES=New,Active,Re-Opened
QUALYS_MIN_SEVERITY=3
QUALYS_INCLUDE_QDS=1
QUALYS_INCLUDE_TAGS=1
QUALYS_REQUESTED_WITH=wazuh-qualys-connector

STATE_FILE=./data/state.json
QID_CACHE_FILE=./data/qid-cache.json
OUTPUT_FILE=./data/qualys.ndjson
FULL_SYNC_DAYS=7

